{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uvx ty:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git revert:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git checkout:*)",
      "Bash(git show-ref:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git stash list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(cd:*)",
      "Bash(mv:*)",
      "Bash(grep:*)",
      "Bash(time:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(pnpm:*)",
      "WebSearch(*)",
      "WebFetch(*)"
    ],
    "deny": ["Read(./.env)", "Read(./secrets/**)"]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s http://host.docker.internal:3456 &"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s http://host.docker.internal:3456 &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/root/.claude/statusline.sh"
  },
   "extraKnownMarketplaces": {
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    }
  },
  "enabledPlugins": {
    "astral@astral-sh": true
  },"env": {
    "ENABLE_LSP_TOOL": "1"
  }

}
